    {
      "tip_index": 9,
      "tip_number": 10,
      "localization_key": "0x5B73FD18",
      "final_text": "Heavier armor offers more protection at the cost of speed and stamina.",
      "category": "Survival",
      "character_count": 70
    },
    {
      "tip_index": 10,
      "tip_number": 11,
      "localization_key": "0x9F109A62",
      "final_text": "Armor varies by body part; try an exposed limb if torso shots bounce off.",
      "category": "Combat",
      "character_count": 73
    },
    {
      "tip_index": 11,
      "tip_number": 12,
      "localization_key": "0xCAFFC293",
      "final_text": "A ricochet indicator means that shot failed to penetrate the armor.",
