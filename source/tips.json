    {
      "tip_index": 0,
      "tip_number": 1,
      "localization_key": "0x573CB314",
      "final_text": "Diving extinguishes fire.",
      "category": "Survival",
      "character_count": 25
    },
    {
      "tip_index": 1,
      "tip_number": 2,
      "localization_key": "0xE12238EC",
      "final_text": "Going prone reduces blast damage, but does not make you explosion-proof.",
      "category": "Survival",
      "character_count": 72
    },
    {
      "tip_index": 2,
      "tip_number": 3,
      "localization_key": "0x14C09C44",
      "final_text": "Stims restore health, heal broken limbs and stop bleeding from injuries.",
      "category": "Survival",
      "character_count": 72
    },
    {
      "tip_index": 3,
      "tip_number": 4,
      "localization_key": "0x7F49E207",
      "final_text": "You can use a stim at full health to restore stamina.",
